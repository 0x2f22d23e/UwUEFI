#!/usr/bin/python3 -u
from pathlib import Path
import os
import subprocess
import sys
import time
import uuid

script_name = "build-all"

if len(sys.argv) < 2:
    raise ValueError(f"{script_name}: wrong number of arguments")


class AttrDict(dict):
    def __init__(self, *args, **kwargs):
        super(AttrDict, self).__init__(*args, **kwargs)
        self.__dict__ = self


build = AttrDict()


def OK(index=1):
    step_name = str(sys._getframe(index).f_code.co_name)
    print(f"\u2705 {script_name}: {step_name}")


def TRY(cmd):
    step_name = str(sys._getframe(1).f_code.co_name)
    res = os.system(cmd)
    if res:
        error_code = str(res)
        raise ValueError(
            f"{script_name}: step '{step_name}' failed, error code {error_code}"
        )
    else:
        OK(2)


def init_values():
    global build
    build.hv = AttrDict()
    build.home_path = f"{Path.home()}/"
    build.edk2_path = f"{build.home_path}cloned/edk2/"
    build.project_path = f"{sys.argv[1]}/"
    build.disk_image = f"{build.project_path}build/disk.img"
    build.gdb_init_file = f"{build.project_path}gdb/default.init"
    build.project_name = build.project_path.rsplit("/")[-2]
    build.tools_path = f"{build.project_path}tools/"
    build.qemu_bin_path = f"qemu-system-x86_64"
    build.qemu_bin_args = " ".join(
        [
            f"-display sdl,grab-mod=rctrl",
            f"-enable-kvm",
            f"-smp cores=4",
            f"-s -S" if build.debug else f"",
            f"-m 8192",
            f"-net none",
            f"-bios /usr/share/edk2/ovmf/OVMF_CODE.fd",
            f"-device qemu-xhci,id=xhci",
            f"-device usb-hub,id=hub,bus=xhci.0,port=1",
            f"-device usb-kbd",
            f"-device usb-mouse,bus=xhci.0,port=1.2",
            f"-device virtio-blk-pci,drive=disk1,bootindex=1",
            f"-drive file={build.disk_image},format=raw,id=disk1,if=none",
            f"-chardev stdio,id=char0,mux=on,signal=off",
            f"-serial chardev:char0",
            f"-monitor telnet::45454,server,nowait",
        ]
    )

    build.templeos_iso_file = f"{build.project_path}iso/TempleOS.ISO"
    OK()


def kill_running_qemu_processes():
    TRY(f'killall -e "{build.qemu_bin_path}" || true')


def kill_running_gdb_processes():
    TRY(f'killall -e "gdb" || true')


def clang_format_src_files():
    TRY(
        "find "
        + build.project_path
        + ' -not -path "*/deps/*" -type f -name "*.c" | xargs -I {} -n1 -r clang-format -i --style=file:'
        + build.project_path
        + ".clang-format {}"
    )


def clang_format_header_files():
    TRY(
        "find "
        + build.project_path
        + ' -not -path "*/deps/*" -type f -name "*.h" | xargs -I {} -n1 -r clang-format -i --style=file:'
        + build.project_path
        + ".clang-format {}"
    )


def clang_format_runtime_files():
    TRY(
        "find "
        + build.project_path
        + 'src/runtime -type f -name "*.HC" | xargs -I {} -n1 -r clang-format -i --style=file:'
        + build.project_path
        + ".clang-format {}"
    )


def refresh_build_path():
    refresh_cmd = (
        f"rm -rf {build.project_path}build && mkdir -p {build.project_path}build"
        if not build.coalesced
        else f"rm -f {build.project_path}build/BOOTX64.EFI"
    )
    TRY(refresh_cmd)


def generate_runtime_patch():
    tmp_path = f"/tmp/{str(uuid.uuid4())}/"
    runtime_c = "patches/runtime.c"
    TRY(
        f" && ".join(
            [
                f"rm -f {build.project_path}{runtime_c}",
                f"mkdir {tmp_path}",
                f'printf "Silent(1);\n" > {tmp_path}Runtime.HC'
                if build.silence_runtime_warnings
                else f"touch {tmp_path}Runtime.HC",
                f"sed 's/^/src\\/runtime\\//' src/runtime/modules.txt | xargs cat >> {tmp_path}Runtime.HC",
                f'printf "Silent(0);\n" >> {tmp_path}Runtime.HC'
                if build.silence_runtime_warnings
                else f"true",
                f"{build.tools_path}todotz.bin {tmp_path}Runtime.HC",
                f"cat src/runtime/prologue.c > {runtime_c}",
                f"xxd -n Runtime_HC_Z -i {tmp_path}Runtime.HC.Z >> {runtime_c}",
                f"cat src/runtime/epilogue.c >> {runtime_c}",
                f"rm -rf {tmp_path}",
            ]
        )
    )


def build_tools_todotz():
    if not os.path.exists(f"{build.tools_path}todotz.bin"):
        TRY(
            f" && ".join(
                [
                    f"mkdir -p {build.tools_path}todotz",
                    f"cd {build.tools_path}",
                    f"wget -q -O todotz/todotz.cpp https://raw.githubusercontent.com/0x2f22d23e/tosutils/refs/heads/master/todotz/todotz.cpp",
                    f"g++ -o todotz.bin todotz/todotz.cpp",
                    f"rm -rf todotz",
                ]
            )
        )


def build_uwuefi():
    build_type_cmd = f"printf '#include \"{f'kernel.c' if build.coalesced else f'kernel_dyn.c'}\"' > {build.project_path}patches/build_type.c"
    edk2_build_cmd = f"build -a X64 -m {build.project_path}UwUEFI.inf -p {build.project_path}UwUEFI.dsc -b RELEASE -t GCC"
    TRY(
        f" && ".join(
            [
                f"scripts/get-baseline-dump"
                if not build.coalesced
                else f"scripts/make-kernel-patch",
                f"cd {build.edk2_path}",
                f"source ./edksetup.sh",
                f"export PACKAGES_PATH={build.edk2_path}:{build.project_path}",
                f"cd {build.project_path}",
                build_type_cmd,
                edk2_build_cmd,
                edk2_build_cmd,
                f"cp {build.edk2_path}Build/UwUEFI/RELEASE_GCC/X64/UwUEFI.efi {build.project_path}build/BOOTX64.EFI",
            ]
        )
    )


def build_disk_image():
    TRY(
        f" && ".join(
            [
                f"rm -f {build.disk_image}",
                f"dd if=/dev/zero of={build.disk_image} bs=1M count=64",
                f'printf "g\nn\n1\n2048\n\nt\n1\nw\n" | fdisk {build.disk_image}',
                f"mformat -i {build.disk_image}@@1M -F -N 1 ::",
                f"mmd -i {build.disk_image}@@1M ::/EFI",
                f"mmd -i {build.disk_image}@@1M ::/EFI/BOOT",
                f"mcopy -i {build.disk_image}@@1M {build.project_path}boot.ini ::/boot.ini || true",
                f"mcopy -i {build.disk_image}@@1M {build.project_path}build/BOOTX64.EFI ::/EFI/BOOT/BOOTX64.EFI",
                f"mcopy -i {build.disk_image}@@1M {build.project_path}iso/TempleOS.ISO ::/TempleOS.ISO",
                f"mcopy -i {build.disk_image}@@1M {build.bootstrap_disk_image} ::/Bootstrap.ISO.C" if len(build.bootstrap_disk_image) > 0 else f"true"
            ]
        )
    )


def gdb():
    TRY(f'xfce4-terminal -e "gdb -x {build.gdb_init_file}" &')


def run():
    TRY(f" ".join([build.qemu_bin_path, build.qemu_bin_args]))


def build_all():
    build.debug = False
    build.coalesced = False
    build.silence_runtime_warnings = True
    build.bootstrap_disk_image = ""
    init_values()
    kill_running_qemu_processes()
    kill_running_gdb_processes()
    clang_format_src_files()
    clang_format_header_files()
    clang_format_runtime_files()
    refresh_build_path()
    build_tools_todotz()
    generate_runtime_patch()
    build_uwuefi()
    build_disk_image()
    if build.debug:
        gdb()
    run()


build_all()
